// Prisma schema for Bodegón POS & High-Speed Inventory Engine
// Optimized for local high-throughput sales, atomic transactions and SQLite WAL mode

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// Model representing Bodegón products with barcode index for sub-millisecond lookups
model Product {
  id             String          @id @default(cuid())
  barcode        String          @unique
  sku            String          @unique
  name           String
  category       String
  price          Float
  wholesalePrice Float?
  cost           Float
  stock          Float
  minStock       Float           @default(5)
  unit           String          @default("UND") // UND, KG, PAQ, BOT, LTR, MTS, G, CM, ML
  presentationsJson String?
  returnableBottleConfigJson String?
  imageUrl       String?
  isWeighable    Boolean         @default(false)
  plu            String?
  isVariablePrice Boolean        @default(false)
  variablePriceCurrency String   @default("USD") // USD, BS
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  saleItems      SaleItem[]
  stockMovements StockMovement[]
  restockAlerts  RestockAlert[]
  auditItems     InventoryAuditItem[]

  @@index([barcode])
  @@index([category])
  @@index([stock, minStock])
}

// Model representing Cash Register Shifts & Arqueo de Caja
model CashShift {
  id              String    @id @default(cuid())
  shiftNumber     Int       @default(1)
  cashierName     String    @default("Caja 1 - Principal")
  registerName    String    @default("Caja Principal")
  status          String    @default("OPEN") // OPEN, CLOSED
  openedAt        DateTime  @default(now())
  closedAt        DateTime?
  bcvRate         Float     // Day's BCV rate saved upon shift creation
  initialCashUsd  Float     @default(0)
  initialCashBs   Float     @default(0)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  sales           Sale[]
  outflows        CashOutflow[]

  @@index([status])
  @@index([cashierName])
  @@index([openedAt])
}

// Model representing completed sales with invoice number and payment methods
model Sale {
  id             String          @id @default(cuid())
  invoiceNumber  String          @unique
  cashierName    String          @default("Caja 1")
  paymentMethod  String          // CASH_USD, CASH_BS, DEBIT_CARD, PAGO_MOVIL, SPLIT
  subtotal       Float
  tax            Float           // IVA (e.g. 16%)
  total          Float
  amountPaid     Float
  changeDue      Float           @default(0)
  bcvRate        Float           @default(849.56) // Immutable historical exchange rate at sale time
  status         String          @default("COMPLETED") // COMPLETED, VOIDED
  notes          String?
  shiftId        String?
  shift          CashShift?      @relation(fields: [shiftId], references: [id])
  createdAt      DateTime        @default(now())

  items          SaleItem[]
  stockMovements StockMovement[]

  @@index([invoiceNumber])
  @@index([shiftId])
  @@index([createdAt, status]) // Índice clave compuesto para el Dashboard
}

// Sale line items with immutable price snapshot at sale time
model SaleItem {
  id             String   @id @default(cuid())
  saleId         String
  sale           Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  productName    String
  productBarcode String
  unitPrice      Float
  quantity       Float
  subtotal       Float
  createdAt      DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

// Immutable audit trail for all stock variations (sales, restocks, adjustments, initial loads, waste)
model StockMovement {
  id            String   @id @default(cuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  saleId        String?
  sale          Sale?    @relation(fields: [saleId], references: [id])
  type          String   // SALE, RESTOCK, ADJUSTMENT, RETURN, INITIAL, WASTE
  quantity      Float    // Negative for sales, positive for restock
  previousStock Float
  newStock      Float
  unitCost      Float?   // Base unit cost recorded at movement time
  userName      String   @default("Admin") // User or cashier who executed
  reason        String?
  createdAt     DateTime @default(now())

  @@index([productId])
  @@index([saleId])
  @@index([createdAt])
  @@index([type])
}

// Restock alerts evaluated automatically every 60s by node-cron
model RestockAlert {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  currentStock Float
  minStock     Float
  severity     String    // CRITICAL (<= 0), WARNING (<= minStock)
  status       String    @default("ACTIVE") // ACTIVE, RESOLVED, ACKNOWLEDGED
  evaluatedAt  DateTime  @default(now())
  resolvedAt   DateTime?

  @@index([status])
  @@index([productId])
  @@index([evaluatedAt])
}

// Model representing Cash Outflows / Egresos de Caja Chica
model CashOutflow {
  id           String    @id @default(cuid())
  shiftId      String
  shift        CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  amountUsd    Float     @default(0)
  amountBs     Float     @default(0)
  reason       String
  authorizedBy String    @default("Administrador")
  createdAt    DateTime  @default(now())

  @@index([shiftId])
  @@index([createdAt])
}

// Physical Inventory Audits & Stock Taking
model InventoryAudit {
  id                String               @id @default(cuid())
  code              Int                  @default(1)
  status            String               @default("IN_PROGRESS") // IN_PROGRESS, COMPLETED, CANCELLED
  type              String               // "CATEGORY" | "MANUAL" | "ALL"
  categoryFilter    String?
  startedAt         DateTime             @default(now())
  completedAt       DateTime?
  createdBy         String               @default("Admin")
  completedBy       String?
  totalLossCost     Float                @default(0)
  totalSurplusCost  Float                @default(0)
  netDifferenceCost Float                @default(0)
  items             InventoryAuditItem[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([status])
  @@index([startedAt])
}

model InventoryAuditItem {
  id             String         @id @default(cuid())
  auditId        String
  audit          InventoryAudit @relation(fields: [auditId], references: [id], onDelete: Cascade)
  productId      String
  product        Product        @relation(fields: [productId], references: [id])
  productName    String
  categoryName   String?
  unit           String         @default("UND")
  systemStock    Float          // Snapshot stock at audit opening
  costPrice      Float          // Snapshot cost at audit opening
  countedStock   Float?         // Physical counted stock entered by auditor
  differenceQty  Float          @default(0) // countedStock - systemStock
  differenceCost Float          @default(0) // differenceQty * costPrice
  salesQty       Float          @default(0) // Real-time sales during count
  inboundQty     Float          @default(0) // Restocks/inputs during count
  outboundQty    Float          @default(0) // Waste/outputs during count
  status         String         @default("PENDING") // PENDING, MATCHED, MISSING, SURPLUS
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([auditId])
  @@index([productId])
}

model User {
  id                  String   @id @default(cuid())
  username            String   @unique
  password            String
  name                String
  isAdmin             Boolean  @default(true)
  role                String   @default("Administrador")
  imageUrl            String?
  allowedDepartments  String   @default("[]")
  allowedFunctions    String   @default("[]")
  canConfigurePrinters Boolean  @default(true)
  canModifyManualRate  Boolean  @default(true)
  cashRegister        String?  // Manually assigned register number (e.g. "1", "2")
  canViewOtherShifts          Boolean  @default(true)
  canViewAllSales             Boolean  @default(true)
  dashboardType               String   @default("ADMIN") // "ADMIN" | "CAJERO"
  canRegisterExpenses         Boolean  @default(true)
  canApplyDiscountOrSurcharge Boolean  @default(true)
  canSellOnCredit             Boolean  @default(true)
  canVoidSales                Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Global System Configuration for Modular Activation & Process Optimization
model SystemConfig {
  id                String   @id @default("default")
  enabledModules    String   @default("[\"kardex\",\"cxc\",\"cxp\",\"audits\",\"alerts\",\"clients\",\"shifts\",\"sales\"]") // JSON array of active optional modules
  cloudSyncEnabled  Boolean  @default(false)
  cloudAppId        String?
  cloudToken        String?
  updatedAt         DateTime @updatedAt
}

// Model representing Exchange Rate History (Historial de Tasas de Cambio Diario y Ajustes)
model ExchangeRateHistory {
  id              String    @id @default(cuid())
  rateDate        DateTime  @default(now())
  usdRate         Float
  eurRate         Float?
  usdtRate        Float?
  previousRate    Float?
  variation       Float?
  source          String    @default("API Oficial BCV")
  dateLabel       String?
  isManual        Boolean   @default(false)
  userName        String?   @default("Sistema")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([rateDate])
  @@index([createdAt])
}

// Model for Time-based Exchange Rate Scripts & Schedules (Programador de Horarios de Tasas)
model RateSchedule {
  id              String    @id @default(cuid())
  name            String    // e.g. "Horario Matutino Euro (09:00 - 10:00)"
  currencyTarget  String    @default("USD") // "USD" | "EUR" | "USDT" | "CUSTOM"
  customRateValue Float?   // Rate in Bs if currencyTarget is "CUSTOM"
  startTime       String    // "09:00" in 24h format
  endTime         String    // "10:00" in 24h format
  durationType    String    @default("INDEFINITE") // "INDEFINITE" | "DATE_RANGE"
  startDate       DateTime? // Start date if durationType === "DATE_RANGE"
  endDate         DateTime? // End date if durationType === "DATE_RANGE"
  daysOfWeek      String    @default("[0,1,2,3,4,5,6]") // JSON array: 0=Domingo..6=Sábado
  isActive        Boolean   @default(true)
  priority        Int       @default(1)
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

// Global Exchange Rate Settings
model RateConfig {
  id               String    @id @default("default")
  activeCurrency   String    @default("USD") // "USD" | "EUR" | "USDT" | "SCHEDULED" | "CUSTOM"
  customFixedRate  Float?
  autoSyncEnabled  Boolean   @default(true)
  syncIntervalMin  Int       @default(5)
  fallbackCurrency String    @default("USD") // Currency to use outside scheduled rules
  updatedAt        DateTime  @updatedAt
}


